# Base URL of the zeiterfassung-server backend used by the "connected invoice"
# hand-off flow (token exchange, work package, encrypted vault/document, number
# reservation, finalize). This is a DIFFERENT service from NEXT_PUBLIC_API_BASE,
# which points at this generator's own preview/render API.
#
# Leave unset to run the generator in standalone-only mode.
NEXT_PUBLIC_ZEITERFASSUNG_API_BASE=https://your-backend-host.example.com
