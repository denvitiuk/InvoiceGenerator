{
  "builds": [
    { "src": "web/next.config.js", "use": "@vercel/next" },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.ts" },
    { "src": "/i18n/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]

}